# Project Tracker Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ==================== REQUIRED PATHS ====================
# Main bidding folder - where your project folders are stored
BIDDING_FOLDER=/path/to/your/bidding/folder

# Mac users: Set the _MAC variant if your Mac path differs from Windows
# BIDDING_FOLDER_MAC=/path/to/mac/bidding/folder

# ==================== OPTIONAL PROJECT FOLDERS ====================
# Additional project folder locations (leave empty if not used)
BRAD_PROJECTS_FOLDER=
BRAD_PROJECTS_FOLDER_MAC=
CURRENT_PROJECTS_FOLDER=
CURRENT_PROJECTS_FOLDER_MAC=

# ==================== PROJECTDOG CREDENTIALS ====================
# Login for projectdog.com scraper
PROJECTDOG_EMAIL=
PROJECTDOG_PASSWORD=

# ==================== SYNC SETTINGS ====================
# How often to sync with ProjectDog (in hours)
SYNC_INTERVAL_HOURS=24

# ==================== LLM API KEYS ====================
# OpenRouter API key (for AI features like project briefs)
# Get one at: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenAI API key (optional - for direct OpenAI calls)
# Get one at: https://platform.openai.com/
OPENAI_API_KEY=

# ==================== EMAIL MONITOR ====================
# Path to email monitor output folder (for bid invite tracking)
EMAIL_MONITOR_PATH=
EMAIL_MONITOR_PATH_MAC=

# ==================== GOVWIN INTEGRATION ====================
# Path to GovWin database file
GOV_DB_PATH=
GOV_DB_PATH_MAC=

# ==================== GOOGLE CUSTOM SEARCH ====================
# For web search features (optional)
# Get keys at: https://console.cloud.google.com/
GOOGLE_API_KEY=
GOOGLE_CX=

# ==================== PLANHUB SCRAPER ====================
# Path to PlanHub SQLite database
PLANHUB_DB_PATH=
PLANHUB_DB_PATH_MAC=

# Sync interval for PlanHub scraper (hours)
PLANHUB_SYNC_INTERVAL_HOURS=24

# Scraper mode: discover, fast, or full
PLANHUB_SCRAPER_MODE=fast

# ==================== MASTERFORMAT (Optional) ====================
# Path to CSI Masterformat breakdown directory
MASTERFORMAT_DIR=
